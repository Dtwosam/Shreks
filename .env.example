# Shreks starts in observe mode. Never place real secrets in this file.
SHREKS_MODE=observe
SHREKS_DB_PATH=data/shreks.db
SHREKS_OBSERVER_INTERVAL_SECONDS=30
SHREKS_LOG_LEVEL=INFO

# Free/public provider configuration. Values are supplied at runtime.
# Helius is disabled when HELIUS_API_KEY is blank. DEX Screener and Meteora
# remain available without keys. The observe runtime does not use Jupiter;
# the explicit paper-evidence runtime requires both Helius and Jupiter keys.
SOLANA_RPC_URL=
HELIUS_API_KEY=
JUPITER_API_KEY=
DEXSCREENER_BASE_URL=
JUPITER_BASE_URL=

# Paper-evidence daemon configuration.
# These values are intentionally blank: economic probe values and collection
# cadence must be chosen explicitly for a real campaign, not inherited from
# permissive test fixtures or hidden production defaults.
SHREKS_PAPER_EVIDENCE_INTERVAL_SECONDS=
SHREKS_PAPER_EVIDENCE_LOOKBACK_SECONDS=
SHREKS_PAPER_EVIDENCE_MAX_CANDIDATES=
SHREKS_PAPER_PROBE_POLICY_VERSION=
SHREKS_PAPER_QUOTE_ASSET_MINT=
SHREKS_PAPER_QUOTE_TAKER=
SHREKS_PAPER_ENTRY_INPUT_AMOUNT=
SHREKS_PAPER_EXIT_INPUT_AMOUNT=
SHREKS_PAPER_SLIPPAGE_BPS=
SHREKS_PAPER_DISTRIBUTION_PAGE_SIZE=
SHREKS_PAPER_DISTRIBUTION_MAX_PAGES=

# G1C paper-campaign runtime bootstrap.
# This namespace is operational only. Trading policy, risk limits, score
# weights, selection bounds, starting capital, and fill/slippage assumptions
# belong in the immutable fingerprinted campaign manifest, not environment.
SHREKS_PAPER_CAMPAIGN_OBSERVER_DB_PATH=
SHREKS_PAPER_CAMPAIGN_E11_PATH=
SHREKS_PAPER_CAMPAIGN_MANIFEST_PATH=
SHREKS_PAPER_CAMPAIGN_INTERVAL_SECONDS=
SHREKS_PAPER_CAMPAIGN_MAX_CYCLES=

# G4 read-only telemetry snapshot.
# These values configure reporting only. They do not alter strategy, risk,
# execution, promotion, signing, submission, wallet, or live authority.
SHREKS_TELEMETRY_PROOF_PATH=
SHREKS_TELEMETRY_PROMOTION_PATH=
SHREKS_TELEMETRY_OUTPUT_PATH=/var/lib/shreks/telemetry/current.json
SHREKS_TELEMETRY_EVALUATION_POLICY_VERSION=
SHREKS_TELEMETRY_CALIBRATION_BUCKET_COUNT=
