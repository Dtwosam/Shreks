# Shreks starts in observe mode. Never place real secrets in this file.
SHREKS_MODE=observe
SHREKS_DB_PATH=data/shreks.db
SHREKS_OBSERVER_INTERVAL_SECONDS=30
SHREKS_LOG_LEVEL=INFO

# Free/public provider configuration. Values are supplied at runtime.
# Helius and Alchemy are disabled when their keys are blank. Helius remains the
# primary FL1 realtime source; Alchemy is the free realtime fallback. DEX
# Screener and Meteora remain available without keys. The observe runtime does
# not use Jupiter; the explicit paper-evidence runtime requires Helius/Jupiter.
SOLANA_RPC_URL=
HELIUS_API_KEY=
ALCHEMY_API_KEY=
CHAINSTACK_SOLANA_WSS_URL=
JUPITER_API_KEY=
DEXSCREENER_BASE_URL=
JUPITER_BASE_URL=

# Paper-evidence daemon configuration.
# These values are intentionally blank: economic probe values and collection
# cadence/selection must be chosen explicitly for a real campaign, not inherited
# from permissive test fixtures or hidden production defaults.
SHREKS_PAPER_EVIDENCE_INTERVAL_SECONDS=
SHREKS_PAPER_EVIDENCE_LOOKBACK_SECONDS=
SHREKS_PAPER_EVIDENCE_MAX_PAIR_AGE_SECONDS=
SHREKS_PAPER_EVIDENCE_PREFERRED_MIN_PAIR_AGE_SECONDS=
SHREKS_PAPER_EVIDENCE_MARKET_SOURCES=
SHREKS_PAPER_EVIDENCE_MAX_CANDIDATES=
SHREKS_PAPER_PROBE_POLICY_VERSION=
SHREKS_PAPER_QUOTE_ASSET_MINT=
SHREKS_PAPER_QUOTE_TAKER=
SHREKS_PAPER_ENTRY_INPUT_AMOUNT=
SHREKS_PAPER_EXIT_INPUT_AMOUNT=
SHREKS_PAPER_SLIPPAGE_BPS=
SHREKS_PAPER_DISTRIBUTION_PAGE_SIZE=
SHREKS_PAPER_DISTRIBUTION_MAX_PAGES=

# G1C paper-campaign runtime bootstrap.
# This namespace is operational only. Trading policy, risk limits, score
# weights, selection bounds, starting capital, and fill/slippage assumptions
# belong in the immutable fingerprinted campaign manifest, not environment.
SHREKS_PAPER_CAMPAIGN_OBSERVER_DB_PATH=
SHREKS_PAPER_CAMPAIGN_E11_PATH=
SHREKS_PAPER_CAMPAIGN_MANIFEST_PATH=
SHREKS_PAPER_CAMPAIGN_INTERVAL_SECONDS=
SHREKS_PAPER_CAMPAIGN_MAX_CYCLES=

# G7 durable operator risk-control state. This path is operational safety state,
# not trading policy. PAPER and the authenticated dashboard read the same file.
SHREKS_RISK_CONTROL_STATE_PATH=/var/lib/shreks/risk/operator-control.json

# G4 read-only telemetry snapshot.
# These values configure reporting only. They do not alter strategy, risk,
# execution, promotion, signing, submission, wallet, or live authority.
SHREKS_TELEMETRY_PROOF_PATH=
SHREKS_TELEMETRY_PROMOTION_PATH=
SHREKS_TELEMETRY_OUTPUT_PATH=/var/lib/shreks/telemetry/current.json
SHREKS_TELEMETRY_EVALUATION_POLICY_VERSION=
SHREKS_TELEMETRY_CALIBRATION_BUCKET_COUNT=

# G5/G7 private operator dashboard.
# Bind only to loopback. The password itself belongs in the protected host-only
# file named below and must never be written into this environment file.
SHREKS_DASHBOARD_BIND_HOST=127.0.0.1
SHREKS_DASHBOARD_PORT=8787
SHREKS_DASHBOARD_USERNAME=
SHREKS_DASHBOARD_PASSWORD_FILE=/etc/shreks/dashboard-password
SHREKS_DASHBOARD_TELEMETRY_PATH=/var/lib/shreks/telemetry/current.json
SHREKS_DASHBOARD_MAX_TRADES=100

# G6 outbound alert notifications.
# The Telegram bot token value belongs only in the protected host file named
# below. These keys configure notification transport/read-side behavior only.
SHREKS_ALERTS_TELEGRAM_CHAT_ID=
SHREKS_ALERTS_TELEGRAM_BOT_TOKEN_FILE=/etc/shreks/telegram-bot-token
SHREKS_ALERTS_STATE_PATH=/var/lib/shreks/alerts/state.json
SHREKS_ALERTS_MARKET_STALE_MS=120000
SHREKS_ALERTS_PROVIDER_FAILURE_MIN_CONSECUTIVE=3
SHREKS_ALERTS_TELEMETRY_PATH=/var/lib/shreks/telemetry/current.json

# G8 verified backup/restore operations.
# Backup policy is operational only: where verified bundles are stored, how
# many completed bundles are retained, and how many coherence attempts are
# allowed. No strategy, risk, wallet, signing, submission, or live keys belong
# in this namespace.
SHREKS_BACKUP_ROOT=/var/lib/shreks/backups
SHREKS_BACKUP_RETENTION_COUNT=168
SHREKS_BACKUP_MAX_CAPTURE_ATTEMPTS=3
