# Shreks starts in observe mode. Never place real secrets in this file.
SHREKS_MODE=observe
SHREKS_DB_PATH=data/shreks.db
SHREKS_OBSERVER_INTERVAL_SECONDS=30
SHREKS_LOG_LEVEL=INFO

# Free/public provider configuration. Values are supplied at runtime.
# Helius is disabled when HELIUS_API_KEY is blank. DEX Screener and Meteora
# remain available without keys. Jupiter is not used by the observe runtime.
SOLANA_RPC_URL=
HELIUS_API_KEY=
DEXSCREENER_BASE_URL=
JUPITER_BASE_URL=
