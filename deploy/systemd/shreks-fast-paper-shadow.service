[Unit]
Description=Shreks learned Fast Lane PAPER shadow service
After=network-online.target shreks-observe.service shreks-paper-evidence.service
Wants=network-online.target shreks-observe.service shreks-paper-evidence.service
RequiresMountsFor=/var/lib/shreks /etc/shreks /opt/shreks/current
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=shreks
Group=shreks
WorkingDirectory=/opt/shreks/current
EnvironmentFile=/etc/shreks/fast-paper-shadow.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -d /var/lib/shreks/fast-paper-shadow
ExecStartPre=/usr/bin/test -w /var/lib/shreks/fast-paper-shadow
ExecStartPre=/opt/shreks/current/.venv/bin/python -m shreks_brain.fast_paper_runtime.shadow_service --preflight
ExecStart=/opt/shreks/current/.venv/bin/python -m shreks_brain.fast_paper_runtime.shadow_service
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shreks/fast-paper-shadow
UMask=0077
